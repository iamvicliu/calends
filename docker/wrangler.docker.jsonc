// Docker 镜像内使用的配置：只在本地模式（workerd + SQLite）运行，不连 Cloudflare
{
  "name": "calends",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "calends", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "worker/migrations" },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
}
