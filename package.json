{
  "name": "calends",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:worker": "node scripts/wrangler.mjs dev --port 8787 --local",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test shared/*.test.ts",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs --check",
    "db:migrate:local": "node scripts/wrangler.mjs d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "deploy": "npm run build && node scripts/wrangler.mjs deploy && node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "seed": "node --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "number-flow": "^0.6.2",
    "preact": "^10.29.8",
    "radix-ui": "^1.8.1",
    "react": "npm:@preact/compat@^18.3.2",
    "react-dom": "npm:@preact/compat@^18.3.2",
    "react-is": "^18.3.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.2"
  },
  "overrides": {
    "react": "npm:@preact/compat@^18.3.2",
    "react-dom": "npm:@preact/compat@^18.3.2"
  },
  "version": "1.0.0",
  "description": "Self-hosted, AI-native subscription ledger: multi-currency, shared plans, balances, reminders and an MCP server. Runs on Cloudflare Workers or Docker.",
  "license": "MIT"
}
