{
  "name": "calends",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:worker": "node scripts/wrangler.mjs dev --port 8787 --local",
    "build": "node scripts/migrations.mjs && node scripts/i18n.mjs && tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test shared/*.test.ts",
    "lint": "oxlint --deny-warnings src shared worker scripts docker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs --check",
    "db:migrate:local": "node scripts/wrangler.mjs d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "deploy": "npm run build && node scripts/wrangler.mjs deploy && node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts --sql > .wrangler/demo.sql && node scripts/wrangler.mjs d1 execute DB --local --file .wrangler/demo.sql"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/matter-js": "^0.20.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.59.0",
    "matter-js": "^0.20.0",
    "motion": "^14.4.0",
    "number-flow": "^0.6.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxc-transform-react": "^0.152.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.2"
  },
  "version": "1.0.0",
  "description": "Self-hosted, AI-native subscription ledger: multi-currency, shared plans, balances, reminders and an MCP server. Runs on Cloudflare Workers or Docker.",
  "license": "MIT"
}
